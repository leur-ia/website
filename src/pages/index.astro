---
import DownloadButton from "../components/DownloadButton.astro";
import Logo from "../components/Logo.astro";
import Ocean from "../components/Ocean.astro";
import TryIt from "../components/TryIt.astro";
import { downloads, SITE_JSON_LD } from "../data/site";
import Base from "../layouts/Base.astro";

/**
 * The argument, one claim per section, each with its proof:
 *   1. Use the AI you already have on the websites you choose. → the real shop, on your AI, in sixteen seconds
 *   2. Set up once, then it's one click per site.         → the Leuria window, four times along
 *   3. Every site asks first; none sees your files.        → what a site can and can't do, in words
 *   4. It works with the AI you have.                      → the AIs, by kind
 *   5. This page runs on your AI: ask it.                  → the live question box
 *   6. It's free. Get it.                                  → the download
 */

/** The clips the first screen cycles through: real sites on a real AI, recorded as is. */
const clips = [
	{ id: "shop", caption: "A shop: its assistant answers from the shop's own stock, and fills an order from a message.", alt: "Kiln & Co., a demo shop, connecting to the visitor's AI through Leuria, answering which mug is cheapest, and filling an order from a message" },
	{ id: "docs", caption: "A documentation site: Ask AI answers from the docs, with links to the pages it used.", alt: "A Docusaurus documentation site with Ask AI: a question answered from the docs, with links to the pages" },
	{ id: "home", caption: "A smart home: a decision model on your computer reads each command; your AI only speaks when words are needed.", alt: "Hearth, a smart home demo: a command read by a decision model on the visitor's computer, with its trace" },
];

/** The four steps, each with what you actually see at that moment. */
const clauses = ["First, get Leuria.", "Then pick your AI.", "Then a site asks.", "Then it answers, from your AI."];

/** The AIs Leuria works with, by kind. */
const kinds = [
	{ id: "app", tab: "An agent you sign in to", short: "Sign in", items: [["Claude Code", "with your Claude account"], ["Codex", "with your OpenAI account"], ["Gemini CLI", "with your Google account"], ["GitHub Copilot, Cursor, Pi…", "and forty more coding agents"]] },
	{ id: "local", tab: "On this computer", short: "Free", items: [["LM Studio", "any chat model you loaded"], ["Ollama", "any chat or decision model"], ["oMLX", "MLX models on Apple Silicon"], ["Your browser's AI", "Chrome's built-in model, without Leuria"]] },
	{ id: "key", tab: "With a key", short: "Your key", items: [["Any OpenAI-compatible API", "OpenAI, Mistral, Groq, OpenRouter…"], ["Your company's AI", "its own address, your key"], ["oMLX", "your Mac's models, served locally"], ["TypeSafe", "a decision model, for sites that decide"]] },
] as const;
---

<Base
	title="Leuria · Use the AI you already have, on the websites you choose"
	description="A free, open-source app that connects the AI you already have (Claude Code, Codex, an API key, or a local model) to the websites you choose. Every site asks first; none sees your files."
	jsonLd={SITE_JSON_LD}
>
	<!-- The manta swims behind the page, faintly; its star lights up over the dark section. -->
	<Ocean />

	<!-- 1 · What Leuria is, in plain words, beside the real clip of it working. -->
	<section class="hero" aria-labelledby="hero-title" data-theme="light">
		<div class="hero-text">
			<h1 id="hero-title">Use the AI you already have, on the websites you choose<span class="punct">.</span></h1>
			<p class="lede">
				Leuria is a small, free app on your computer. It connects the AI you already have to the websites that ask for it: an agent you sign in to (Claude Code,
				Codex, Gemini CLI and others), any OpenAI-compatible API with your key, or a model running on your machine. Each site asks first, you
				say yes once, and none of them ever sees your files.
			</p>
			<div class="hero-actions">
				<DownloadButton more />
				<a class="btn btn-link" href="#how">See how it works</a>
			</div>
			<ul class="facts">
				<li>Every site asks first</li>
				<li>No site sees your files</li>
				<li>Free and open source</li>
			</ul>
		</div>
		<figure class="hero-clip" data-reel data-captions={JSON.stringify(clips.map((c) => c.caption))}>
			<!-- Three scenes, sixteen to nineteen seconds each, one after the other; a desktop window on wide screens, a phone-sized one on small ones. -->
			<div class="reel-stage">
				{
					clips.map((clip, i) => (
						<>
							<video class:list={["clip", "clip-desktop", { on: i === 0 }]} data-scene={i} muted playsinline autoplay={i === 0} preload={i === 0 ? "auto" : "none"} poster={`/video/leuria-${clip.id}-desktop.jpg`} width="1440" height="900" aria-label={clip.alt}>
								<source src={`/video/leuria-${clip.id}-desktop.mp4`} type="video/mp4" />
							</video>
							<video class:list={["clip", "clip-mobile", { on: i === 0 }]} data-scene={i} muted playsinline preload="none" poster={`/video/leuria-${clip.id}-mobile.jpg`} width="860" height="1864" aria-label={`${clip.alt}, on a phone-sized window`}>
								<source src={`/video/leuria-${clip.id}-mobile.mp4`} type="video/mp4" />
							</video>
						</>
					))
				}
			</div>
			<figcaption>
				<span data-caption>{clips[0]!.caption}</span>
				<span class="reel-dots" role="tablist" aria-label="Scenes">
					{clips.map((clip, i) => <button type="button" role="tab" aria-selected={i === 0} aria-label={clip.id} data-dot={i} class:list={{ on: i === 0 }} />)}
				</span>
			</figcaption>
		</figure>
	</section>

	<!-- 2 · Four fields: what you see at each step, as it really looks (the menu bar, the app, its window, the site). -->
	<section class="fields" aria-labelledby="fields-title" data-theme="light">
		<div class="field f1 reveal">
			<h2 id="fields-title" class="fields-title">Set up once<span class="punct">.</span></h2>
			<div class="shot get-step">
				<DownloadButton more />
				<p>A small app. It waits in your menu bar until a site needs it.</p>
			</div>
			<p class="clause">{clauses[0]}</p>
		</div>
		<div class="field f2 reveal">
			<img class="shot photo" src="/steps/add-an-ai.png" width="718" height="552" alt="Leuria's window: Add an AI, step 1 of 3. An AI app you use, a model on this computer, or an AI service with a key." loading="lazy" />
			<p class="clause">{clauses[1]}</p>
		</div>
		<div class="field f3 reveal">
			<img class="shot photo tall" src="/steps/site-asks.png" width="424" height="524" alt="Leuria's window when a site asks: Kiln & Co. (demo) wants to use your AI. Answers with Claude · Haiku 5.5, right for this site. It can ask your AI to answer you and let it use this site's features; it can't see your files or run programs, or see what you do on other websites. Not now, or Allow." loading="lazy" />
			<p class="clause">{clauses[2]}</p>
		</div>
		<div class="field f4 reveal">
			<img class="shot photo wide" src="/steps/site-answers.png" width="532" height="400" alt="The shop's Ask us panel, answered by your AI, Claude · Haiku 5.5: the cheapest mug is the plain white mug at €7, with 130 in stock." loading="lazy" />
			<p class="clause">{clauses[3]}</p>
		</div>
	</section>

	<!-- 3 · Privacy, in plain words: what a connected site can and can't do, and where you see them all. -->
	<section class="privacy" id="privacy" aria-labelledby="privacy-title" data-theme="dark">
		<div class="privacy-text">
			<h2 id="privacy-title">Every site asks first<span class="punct">.</span></h2>
			<p>A website can't use your AI until you say yes, in Leuria's own window. The window says what it may do, and what it may not.</p>
		</div>
		<dl class="rules">
			<div class="rule can">
				<dt>A site you allow can</dt>
				<dd>Ask your AI to answer you.</dd>
				<dd>Let your AI use that site's own features: search its products, read its notes.</dd>
			</div>
			<div class="rule cant">
				<dt>It can't</dt>
				<dd>See your files, or run programs on your computer.</dd>
				<dd>See your password or your AI account.</dd>
				<dd>See what you do on other websites.</dd>
			</div>
			<div class="rule">
				<dt>And you</dt>
				<dd>See every connected site in Leuria, with the AI that answers it, and disconnect any of them in one click.</dd>
				<dd>See what each site asked of your AI today, and pause any site that asks too much. No site can ask more than 120 times an hour, or 20 times from a tab you are not looking at.</dd>
				<dd>With a model on your computer, nothing leaves it at all.</dd>
			</div>
		</dl>
	</section>

	<!-- 5 · The AI you have, by kind: tabs and bands. -->
	<section class="ais" aria-labelledby="ais-title" id="how" data-theme="light">
		<div class="ais-head">
			<h2 id="ais-title" class="two-tone"><span>Works with</span> <br />the AI you have<span class="punct">.</span></h2>
			<DownloadButton />
		</div>
		<div class="ais-body" data-kinds>
			<div class="tabs" role="tablist" aria-label="Kinds of AI">
				{
					kinds.map((kind, i) => (
						<button type="button" role="tab" id={`tab-${kind.id}`} aria-selected={i === 0} aria-controls={`panel-${kind.id}`} class="tab" data-tab={kind.id}>
							<span class="tab-name">{kind.tab}</span>
							<span class="tab-note">{kind.short}</span>
						</button>
					))
				}
			</div>
			{
				kinds.map((kind, i) => (
					<ul class="bands" role="tabpanel" id={`panel-${kind.id}`} aria-labelledby={`tab-${kind.id}`} hidden={i !== 0}>
						{kind.items.map(([name, note]) => (
							<li class="band">
								<span class="band-tag">{kind.short}</span>
								<span class="band-main">
									<span class="band-title">{name}</span>
									<span class="band-note">{note}</span>
								</span>
								<span class="band-right">Chat · tools</span>
							</li>
						))}
					</ul>
				))
			}
		</div>
	</section>

	<!-- 5 · The live thing: this page runs on your AI. -->
	<section class="try" aria-labelledby="try-title" data-theme="light">
		<div class="try-text">
			<h2 id="try-title">This page runs <br />on your AI<span class="punct">.</span></h2>
			<p>Already have Leuria? Connect it, then ask anything about Leuria. Your AI reads this page to answer, and nothing else.</p>
		</div>
		<div class="try-box" data-ui><TryIt /></div>
	</section>

	<!-- 6 · A sentence with a blank: the download. -->
	<section class="get" aria-labelledby="get-title" data-theme="light">
		<!-- A div, not a p: the menu is a list, which a paragraph may not hold. -->
		<div class="get-line" id="get-title">
			Yours, free, for
			<span class="get-system" data-system data-value="mac">
				<button type="button" class="get-word" aria-haspopup="listbox" aria-expanded="false" aria-label="Your system: Mac" data-word-button>
					<span class="word-roll" data-word>Mac</span>
					<svg class="chev" viewBox="0 0 16 16" width="0.5em" height="0.5em" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
				</button>
				<ul class="get-menu" role="listbox" aria-label="Your system" hidden data-menu>
					<li role="option" aria-selected="true" data-option="mac">Mac</li>
					<li role="option" aria-selected="false" data-option="windows">Windows</li>
					<li role="option" aria-selected="false" data-option="linux">Linux</li>
				</ul>
			</span>
			<a class="get-go" href="/download" data-go data-downloads={JSON.stringify(downloads)}>Download</a>
		</div>
		<p class="get-note" data-note>A small app that waits in the background until a site needs it. Other systems and versions on the download page.</p>
	</section>
</Base>

<script>
	import type { Build, Platform } from "../data/site";
	import { platform } from "../scripts/browser";

	document.documentElement.classList.add("js");

	// The reel through the sentence: frames pass as the page scrolls (CSS scroll timeline), nothing hijacked.
	// The first screen's reel: one scene plays (the size that fits the screen), then the next, round and round.
	const captions = JSON.parse(document.querySelector<HTMLElement>("[data-reel]")!.dataset.captions ?? "[]") as string[];
	const dots = [...document.querySelectorAll<HTMLButtonElement>("[data-dot]")];
	const caption = document.querySelector<HTMLElement>("[data-caption]")!;
	const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
	let scene = 0;
	const show = (next: number) => {
		scene = next;
		for (const video of document.querySelectorAll<HTMLVideoElement>(".reel-stage .clip")) {
			const mine = Number(video.dataset.scene) === scene;
			video.classList.toggle("on", mine);
			if (mine && video.offsetParent !== null && !still) {
				// Six clips at once would queue behind each other: each loads only when its turn comes.
				if (video.preload === "none") {
					video.preload = "auto";
					video.load();
				} else if (video.readyState > 0) video.currentTime = 0;
				video.muted = true;
				video.play().catch(() => undefined);
			} else video.pause();
		}
		for (const dot of dots) {
			const on = Number(dot.dataset.dot) === scene;
			dot.classList.toggle("on", on);
			dot.setAttribute("aria-selected", String(on));
		}
		caption.textContent = captions[scene] ?? "";
	};
	for (const video of document.querySelectorAll<HTMLVideoElement>(".reel-stage .clip")) {
		video.addEventListener("ended", () => {
			if (Number(video.dataset.scene) === scene) show((scene + 1) % captions.length);
		});
	}
	for (const dot of dots) dot.addEventListener("click", () => show(Number(dot.dataset.dot)));
	show(0);
	matchMedia("(max-width: 860px)").addEventListener("change", () => show(scene));
	// A tab opened in the background loads no media until it is looked at: start again then.
	document.addEventListener("visibilitychange", () => {
		if (document.visibilityState === "visible") show(scene);
	});

	// The AIs, by kind.
	const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-tab]")];
	for (const tab of tabs) {
		tab.addEventListener("click", () => {
			for (const t of tabs) t.setAttribute("aria-selected", String(t === tab));
			for (const panel of document.querySelectorAll<HTMLElement>("[role=tabpanel]")) panel.hidden = panel.id !== `panel-${tab.dataset.tab}`;
		});
	}

	// The download sentence: the visitor's system filled in; the word is a menu, and swapping it rolls like a counter.
	const system = document.querySelector<HTMLElement>("[data-system]")!;
	const wordButton = system.querySelector<HTMLButtonElement>("[data-word-button]")!;
	const word = system.querySelector<HTMLElement>("[data-word]")!;
	const menu = system.querySelector<HTMLUListElement>("[data-menu]")!;
	const options = [...menu.querySelectorAll<HTMLLIElement>("[data-option]")];
	const go = document.querySelector<HTMLAnchorElement>("[data-go]")!;
	const note = document.querySelector<HTMLElement>("[data-note]")!;
	const builds = JSON.parse(go.dataset.downloads ?? "{}") as Record<Platform, Build>;
	const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
	const outCurve = "cubic-bezier(0.77, 0, 0.175, 1)";
	const inCurve = "cubic-bezier(0.23, 1, 0.32, 1)";

	const apply = () => {
		const value = system.dataset.value as Platform;
		const build = builds[value];
		go.href = build?.url ?? "/download";
		wordButton.setAttribute("aria-label", `Your system: ${build?.name ?? value}`);
		for (const o of options) o.setAttribute("aria-selected", String(o.dataset.option === value));
		note.textContent = build?.url
			? "A small app that waits in the background until a site needs it. Other systems and versions on the download page."
			: `Not built for ${build?.name ?? value} yet: the download page says when. Mac and Windows are ready.`;
	};
	const choose = async (value: Platform) => {
		if (value === system.dataset.value) return;
		const name = builds[value]?.name ?? value;
		if (!reduced) {
			// The old word rolls up and out, the new one rolls in from below: one counter tick, 120 + 180 ms.
			await word.animate([{ transform: "translateY(0)", opacity: 1 }, { transform: "translateY(-0.45em)", opacity: 0 }], { duration: 120, easing: outCurve, fill: "forwards" }).finished;
		}
		system.dataset.value = value;
		word.textContent = name;
		apply();
		if (!reduced) word.animate([{ transform: "translateY(0.45em)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 }], { duration: 180, easing: inCurve, fill: "forwards" });
	};
	const open = (show: boolean) => {
		wordButton.setAttribute("aria-expanded", String(show));
		if (show) {
			menu.hidden = false;
			if (!reduced) menu.animate([{ transform: "scale(0.96)", opacity: 0 }, { transform: "scale(1)", opacity: 1 }], { duration: 150, easing: inCurve });
			(options.find((o) => o.getAttribute("aria-selected") === "true") ?? options[0])?.focus();
		} else if (!menu.hidden) {
			const close = reduced ? null : menu.animate([{ transform: "scale(1)", opacity: 1 }, { transform: "scale(0.98)", opacity: 0 }], { duration: 100, easing: "ease" });
			(close ? close.finished : Promise.resolve()).then(() => (menu.hidden = true));
		}
	};
	wordButton.addEventListener("click", () => open(menu.hasAttribute("hidden")));
	for (const o of options) {
		o.tabIndex = -1;
		o.addEventListener("click", () => {
			void choose(o.dataset.option as Platform);
			open(false);
			wordButton.focus();
		});
	}
	menu.addEventListener("keydown", (e) => {
		const i = options.indexOf(document.activeElement as HTMLLIElement);
		if (e.key === "ArrowDown") options[(i + 1) % options.length]?.focus();
		else if (e.key === "ArrowUp") options[(i - 1 + options.length) % options.length]?.focus();
		else if (e.key === "Enter" || e.key === " ") (document.activeElement as HTMLElement)?.click();
		else if (e.key === "Escape") {
			open(false);
			wordButton.focus();
		} else return;
		e.preventDefault();
	});
	document.addEventListener("pointerdown", (e) => {
		if (!system.contains(e.target as Node)) open(false);
	});
	const detected = platform();
	if (detected) {
		system.dataset.value = detected;
		word.textContent = builds[detected]?.name ?? detected;
	}
	apply();

	// Each section's parts rise once as it enters.
	const seen = new IntersectionObserver(
		(entries) => {
			for (const e of entries) {
				if (e.isIntersecting) {
					e.target.classList.add("is-in");
					seen.unobserve(e.target);
				}
			}
		},
		{ rootMargin: "0px 0px -10% 0px" },
	);
	for (const el of document.querySelectorAll(".reveal")) seen.observe(el);
</script>

<style>
	/* One grid for the page: 12 columns inside the margin. */
	:root {
		--margin: clamp(16px, 2.5vw, 32px);
		--ease-out: cubic-bezier(0.23, 1, 0.32, 1);
		--ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
	}
	.punct {
		margin-left: -0.14em;
	}
	/* The manta swims between the sections' grounds and their content: grounds below it, words and pictures above. */
	:global(main) > section {
		position: relative;
	}
	:global(main) > section > * {
		position: relative;
		z-index: 2;
	}
	h2 {
		font-size: clamp(36px, 4vw, 60px);
		line-height: 1;
		font-weight: 800;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}
	.two-tone span:first-child {
		color: var(--text-muted);
	}

	/* ---------- 1 · What it is, beside the clip ---------- */
	.hero {
		display: grid;
		grid-template-columns: 5fr 7fr;
		column-gap: 48px;
		align-items: center;
		min-height: calc(100svh - 68px);
		padding: clamp(32px, 6vh, 72px) var(--margin);
	}
	.hero-text {
		display: flex;
		flex-direction: column;
		gap: 24px;
		align-items: flex-start;
	}
	.hero h1 {
		font-size: clamp(34px, 3.6vw, 52px);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.05;
		max-width: 20ch;
	}
	.lede {
		font-size: var(--step-lead);
		line-height: 1.4;
		max-width: 52ch;
		color: var(--text);
	}
	.hero-actions {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
	}
	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		margin: 8px 0 0;
		padding: 0;
		list-style: none;
		font-size: 16px;
		font-weight: 600;
	}
	.facts li::before {
		content: "";
		display: inline-block;
		width: 8px;
		height: 8px;
		margin-right: 10px;
		border-radius: 50%;
		background: var(--sage-9);
		vertical-align: 2px;
	}
	.hero-clip {
		margin: 0;
		justify-self: center;
		display: flex;
		flex-direction: column;
		gap: 12px;
		align-items: center;
	}
	.reel-stage {
		display: grid;
		width: 100%;
	}
	.reel-stage .clip {
		grid-area: 1 / 1;
		width: 100%;
		height: auto;
		border-radius: 14px;
		background: var(--pearl-3);
		opacity: 0;
		transition: opacity 500ms ease;
	}
	.reel-stage .clip.on {
		opacity: 1;
		position: relative;
		z-index: 1;
	}
	.clip-mobile {
		display: none;
	}
	.hero-clip figcaption {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
	}
	.reel-dots {
		display: flex;
		gap: 8px;
	}
	.reel-dots button {
		width: 8px;
		height: 8px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: var(--pearl-7);
		cursor: pointer;
		transition: background-color 150ms ease, transform 160ms var(--ease-out);
	}
	.reel-dots button.on {
		background: var(--ink);
		transform: scale(1.25);
	}
	.hero-clip figcaption [data-caption] {
		display: block;
		font-size: 15px;
		color: var(--text-muted);
		max-width: 40ch;
		text-align: center;
		min-height: 2.6em;
	}

	/* ---------- 2 · One card, four fields ---------- */
	.fields {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
	}
	.field {
		position: relative;
		min-height: 520px;
		padding: 28px;
		display: flex;
		flex-direction: column;
	}
	.f1 { background: var(--pearl-3); }
	.f2 { background: var(--lavender-3); }
	.f3 { background: var(--ice-3); }
	.f4 { background: var(--sage-3); }
	.fields-title {
		font-size: clamp(22px, 2vw, 32px);
		margin-bottom: auto;
	}
	/* Each step's picture, built as the real thing looks, 300px wide, at the same height in every field. */
	.shot {
		position: absolute;
		left: 50%;
		top: 40%;
		transform: translate(-50%, -50%);
		width: 300px;
