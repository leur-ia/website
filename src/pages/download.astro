---
/**
 * The download: one build per system, the visitor's own first; the one-time step their system asks for; then three steps.
 * Same vocabulary as the home page: text left, flat bands, no ornament.
 */
import FirstOpen from "../components/FirstOpen.astro";
import Icon from "../components/Icon.astro";
import Ocean from "../components/Ocean.astro";
import { BREW_INSTALL, SITE_JSON_LD, downloads, type Platform } from "../data/site";
import Base from "../layouts/Base.astro";

const platforms = Object.entries(downloads) as Array<[Platform, (typeof downloads)[Platform]]>;
---

<Base
	title="Download Leuria"
	description="Download Leuria, free and open source, for Mac or Windows. Use the AI you already have on the websites you choose: Claude Code, Codex, an API key, or a model on your computer."
	headerDownload={false}
	jsonLd={SITE_JSON_LD}
>
	<Ocean intro={false} />

	<!-- 1 · The builds. -->
	<section class="download" aria-labelledby="download-title" data-theme="light">
		<div class="download-text">
			<h1 id="download-title">Download Leuria<span class="punct">.</span></h1>
			<p class="lede">Free and open source. A small app for your Mac or Windows PC, not your phone: it waits in the menu bar until a website needs your AI.</p>
		</div>

		<div class="phone">
			<p class="phone-title">On a phone<span class="punct">?</span></p>
			<p class="muted">Leuria runs on a Mac or a Windows PC, not on phones or tablets yet. Here it is on a shop that answers with your AI and fills in your order from a message.</p>
			<video src="/video/leuria-demo.mp4" poster="/video/leuria-demo.jpg" autoplay muted loop playsinline width="720" height="1440">
				A shop answering a question and filling in an order with the visitor's own AI.
			</video>
			<button type="button" class="btn btn-ink" data-send hidden>Send this page to my computer</button>
		</div>

		<ul class="platforms bands">
			{
				platforms.map(([id, build]) => (
					<li class="platform band" data-platform={id}>
						<span class="band-tag">
							<h2>{build.name}</h2>
							<span class="yours">Your computer</span>
						</span>
						<span class="band-main">
							{build.url ? (
								<>
									<a class="btn btn-quiet" href={build.url} data-get>
										<Icon name="download" />
										Download for {build.name}
									</a>
									{build.intel && (
										<a class="other" href={build.intel} data-intel>
											Intel Mac? Download this one
										</a>
									)}
									{build.arm && (
										<a class="other" href={build.arm} data-arm>
											Windows on ARM? Download this one
										</a>
									)}
									{build.msi && (
										<span class="other">
											For companies, an MSI for every user: <a href={build.msi}>Intel or AMD</a>
											{build.armMsi && (
												<>
													{" · "}
													<a href={build.armMsi}>ARM</a>
												</>
											)}
										</span>
									)}
								</>
							) : (
								<span class="soon">Not available yet</span>
							)}
						</span>
					</li>
				))
			}
		</ul>
		{platforms.every(([, build]) => !build.url) && <p class="note">The first builds are on their way. Check back soon.</p>}

		<div class="brew">
			<p class="brew-title">Prefer Homebrew<span class="punct">?</span></p>
			<div class="brew-line">
				<code data-brew>{BREW_INSTALL}</code>
				<button type="button" class="btn btn-quiet" data-brew-copy><Icon name="copy" size={16} /><span data-brew-label>Copy</span></button>
			</div>
		</div>
		<p class="note">How we sign our builds: <a href="/code-signing">code signing policy</a>.</p>
	</section>

	<FirstOpen system="mac" />
	<FirstOpen system="windows" />

	<!-- 2 · Then three steps. -->
	<section class="next" aria-labelledby="next-title" data-theme="light">
		<h2 id="next-title" class="two-tone"><span>Three steps,</span> <br />then you're set<span class="punct">.</span></h2>
		<ol class="bands steps">
			<li class="band">
				<span class="band-tag">1</span>
				<span class="band-main">
					<span class="band-title">Open Leuria</span>
					<span class="band-note">
						Install it and open it. The first time, your computer asks you to <a href="#first-open" data-first-open>allow it once</a>. It then stays in the
						background, ready for the sites you connect.
					</span>
				</span>
			</li>
			<li class="band">
				<span class="band-tag">2</span>
				<span class="band-main">
					<span class="band-title">Choose your AI</span>
					<span class="band-note">An agent you sign in to (Claude Code, Codex, Gemini CLI…), a model on your computer, or an AI service with a key.</span>
				</span>
			</li>
			<li class="band">
				<span class="band-tag">3</span>
				<span class="band-main">
					<span class="band-title">Connect a site</span>
					<span class="band-note">Click “Connect your AI” on a site that offers it, and allow it in Leuria's window.</span>
				</span>
			</li>
		</ol>
	</section>
</Base>

<script>
	import { architecture, copyText, platform } from "../scripts/browser";

	// Put the visitor's own system first, and say so.
	const system = platform();
	const card = system && document.querySelector<HTMLElement>(`[data-platform="${system}"]`);
	if (card) {
		card.classList.add("is-yours");
		card.parentElement?.prepend(card);
		card.querySelector("[data-get]")?.classList.replace("btn-quiet", "btn-ink");
	}

	// Chrome and Edge can tell the processor: offer an Intel Mac or Windows on ARM its own build first.
	void architecture().then((arch) => {
		const swap = (platform: string, other: string, when: string, label: string) => {
			const get = document.querySelector<HTMLAnchorElement>(`[data-platform="${platform}"] [data-get]`);
			const alt = document.querySelector<HTMLAnchorElement>(`[data-platform="${platform}"] [${other}]`);
			if (arch !== when || !get || !alt) return;
			[get.href, alt.href] = [alt.href, get.href];
			alt.textContent = label;
		};
		// Only on the visitor's own system: an Apple Silicon Mac says "arm" too.
		if (system === "mac") swap("mac", "data-intel", "x86", "Apple Silicon Mac? Download this one");
		if (system === "windows") swap("windows", "data-arm", "arm", "Windows on an Intel or AMD PC? Download this one");
	});

	// Show only the visitor's own "allow it once" steps, when we know their system.
	if (system === "mac" || system === "windows") {
		for (const section of document.querySelectorAll<HTMLElement>("[data-system]")) section.hidden = section.dataset.system !== system;
		if (system === "windows") document.querySelector<HTMLAnchorElement>("[data-first-open]")?.setAttribute("href", "#first-open-windows");
	}

	// After a download, show that system's one-time step while it downloads.
	for (const [build, guide] of [
		['a[href$=".dmg"]', "#first-open"],
		['a[href$=".exe"], a[href$=".msi"]', "#first-open-windows"],
	]) {
		const section = document.querySelector<HTMLElement>(guide);
		for (const link of document.querySelectorAll<HTMLAnchorElement>(`.platforms ${build}`)) {
			link.addEventListener("click", () => {
				if (!section) return;
				section.hidden = false;
				section.classList.add("is-downloading");
				setTimeout(() => section.scrollIntoView({ block: "start" }), 400);
			});
		}
	}

	// On a phone: send this page to the computer where Leuria will run.
	const send = document.querySelector<HTMLButtonElement>("[data-send]");
	if (send && typeof navigator.share === "function") {
		send.hidden = false;
		send.addEventListener("click", () => void navigator.share({ title: "Download Leuria", url: location.href }).catch(() => undefined));
	}

	const copy = document.querySelector<HTMLButtonElement>("[data-brew-copy]");
	copy?.addEventListener("click", async () => {
		const label = copy.querySelector("[data-brew-label]")!;
		const brew = document.querySelector("[data-brew]")!;
		label.textContent = (await copyText(brew.textContent!.trim(), brew)) ? "Copied" : "Selected";
		setTimeout(() => (label.textContent = "Copy"), 2000);
	});
</script>

<style>
	:root {
		--margin: clamp(16px, 2.5vw, 32px);
		--ease-out: cubic-bezier(0.23, 1, 0.32, 1);
	}
	.punct {
		margin-left: -0.14em;
	}
	:global(main) > section {
		position: relative;
	}
	:global(main) > section > * {
		position: relative;
		z-index: 2;
	}
	h1 {
		font-size: clamp(34px, 3.6vw, 52px);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.05;
	}
	.next h2 {
		font-size: clamp(36px, 4vw, 60px);
		line-height: 1;
		font-weight: 800;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}
	.two-tone span:first-child {
		color: var(--text-muted);
	}

	/* ---------- 1 · The builds ---------- */
	.download {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 40px;
		max-width: 1040px;
		padding: clamp(48px, 8vh, 96px) var(--margin) clamp(64px, 10vh, 120px);
	}
	.download-text {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.lede {
		font-size: var(--step-lead);
		line-height: 1.4;
		max-width: 52ch;
	}

	/* Only on phones and tablets, where Leuria doesn't run. */
	.phone {
		display: none;
	}
	@media (hover: none) and (pointer: coarse) {
		.phone {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 16px;
			width: 100%;
			padding: 20px;
			border-radius: 14px;
			background: var(--pearl-3);
		}
		.phone [hidden] {
			display: none;
		}
	}
	.phone-title {
		font-weight: 700;
		font-size: 20px;
	}
	.phone video {
		width: 100%;
		max-width: 320px;
		height: auto;
		border-radius: 10px;
		background: var(--pearl-2);
	}

	/* The bands: one per system, the visitor's own first. */
	.bands {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
		width: 100%;
	}
	.band {
		display: grid;
		grid-template-columns: 160px 1fr;
		align-items: center;
		column-gap: 24px;
		min-height: 76px;
		padding: 16px 20px;
		border-radius: 8px;
		background: var(--pearl-2);
	}
	.band:nth-child(even) {
		background: var(--pearl-3);
	}
	.band-tag {
		display: flex;
		flex-direction: column;
		gap: 4px;
		font-size: 18px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.band-tag h2 {
		font-size: 20px;
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.band-main {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px 20px;
	}
	.platform.is-yours {
		background: var(--lavender-3);
	}
	.yours {
		display: none;
		font-size: 13px;
		font-weight: 600;
		color: var(--accent-text);
	}
	.is-yours .yours {
		display: block;
	}
	.other {
		color: var(--text-muted);
		font-size: 14px;
	}
	a.other:hover,
	.other a:hover {
		color: var(--accent-text);
	}
	.other a {
		color: inherit;
	}
	.soon {
		color: var(--text-muted);
		font-weight: 600;
	}
	.note {
		font-size: 15px;
		color: var(--text-muted);
	}
	.note a {
		color: inherit;
	}

	.brew {
		display: flex;
		flex-direction: column;
		gap: 12px;
		width: min(640px, 100%);
	}
	.brew-title {
		font-weight: 700;
	}
	.brew-line {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
	}
	.brew code {
		flex: 1;
		min-width: 0;
		padding: 10px 14px;
		border-radius: 8px;
		background: var(--pearl-3);
		font-size: 14px;
		/* Keep "--cask" as two hyphens, never a joined dash. */
		font-variant-ligatures: none;
		font-feature-settings: "calt" 0, "liga" 0;
		overflow-wrap: anywhere;
		user-select: all;
	}

	/* ---------- 2 · Three steps ---------- */
	.next {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 40px;
		padding: clamp(96px, 12vh, 180px) var(--margin) clamp(48px, 8vh, 96px);
	}
	.steps .band {
		grid-template-columns: 56px 1fr;
		align-items: start;
	}
	.steps .band-main {
		flex-direction: column;
		align-items: flex-start;
		gap: 4px;
	}
	.band-title {
		font-size: 18px;
		font-weight: 600;
	}
	.band-note {
		font-size: 16px;
		line-height: 1.4;
		color: var(--text-muted);
		max-width: 60ch;
	}
	.band-note a {
		color: var(--accent-text);
	}

	@media (max-width: 860px) {
		.download { padding: 24px 16px 48px; gap: 28px; }
		h1 { font-size: 9vw; }
		.lede { font-size: 17px; }
		.band { grid-template-columns: 1fr; row-gap: 10px; padding: 14px 16px; }
		.band-tag { flex-direction: row; align-items: baseline; gap: 12px; }
		.next { padding: 64px 16px 48px; gap: 28px; }
		.steps .band { grid-template-columns: 32px 1fr; }
	}
</style>
