---
/** The manta, alone or with the lowercase wordmark. Ink on light and Pearl grounds. */
interface Props {
	size?: number;
	wordmark?: boolean;
}

const { size = 28, wordmark = true } = Astro.props;
const MANTA =
	"M181 61 C184 74 191 82 206 86 C191 90 184 98 181 111 C178 98 171 90 156 86 C171 82 178 74 181 61 Z M59 92 C60 109 67 128 79 143 C91 158 105 168 124 174 C149 182 164 193 171 207 C177 219 177 239 177 255 C182 255 182 240 184 226 C188 199 201 187 223 179 C247 171 270 158 284 142 C298 127 303 109 303 92 C298 91 292 101 284 108 C265 125 245 130 226 126 C217 124 211 114 205 112 C199 110 199 116 199 121 C198 127 191 130 181 130 C171 130 165 127 163 121 C162 116 165 110 159 111 C151 112 148 122 137 126 C118 131 98 125 78 109 C69 102 65 91 59 92 Z";
---

<span class="logo" role={wordmark ? "img" : undefined} aria-label={wordmark ? "Leuria" : undefined} style={`--size: ${size}px`}>
	<svg class="mark" width={size} height={size} viewBox="53 30 256 256" aria-hidden="true"><path d={MANTA} fill="currentColor"></path></svg>
	{wordmark && <span class="wordmark" aria-hidden="true">leuria</span>}
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: calc(var(--size) * 0.28);
		color: var(--ink);
		line-height: 1;
	}
	.mark {
		display: block;
		flex-shrink: 0;
	}
	.wordmark {
		font-weight: 800;
		font-size: calc(var(--size) * 0.78);
		letter-spacing: -0.04em;
	}
</style>
