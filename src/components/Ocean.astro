---
/**
 * The backdrop behind the content: specks of light drift, the manta swims
 * along with the reader, and its star lights up once the page turns dark.
 *
 * Sections declare their ground with `data-theme="light"` or `"dark"`.
 * Decorative: everything here is aria-hidden.
 */
const MANTA_BODY =
	"M59 92 C60 109 67 128 79 143 C91 158 105 168 124 174 C149 182 164 193 171 207 C177 219 177 239 177 255 C182 255 182 240 184 226 C188 199 201 187 223 179 C247 171 270 158 284 142 C298 127 303 109 303 92 C298 91 292 101 284 108 C265 125 245 130 226 126 C217 124 211 114 205 112 C199 110 199 116 199 121 C198 127 191 130 181 130 C171 130 165 127 163 121 C162 116 165 110 159 111 C151 112 148 122 137 126 C118 131 98 125 78 109 C69 102 65 91 59 92 Z";
interface Props {
	/** The home page's intro: a big manta beside the headline that shrinks as you scroll. Off: it just swims, faintly. */
	intro?: boolean;
}

const { intro = true } = Astro.props;
const STAR = "M181 61 C184 74 191 82 206 86 C191 90 184 98 181 111 C178 98 171 90 156 86 C171 82 178 74 181 61 Z";
---

<div class="ocean" aria-hidden="true" data-ocean data-intro={intro ? "" : undefined}>
	<canvas class="snow" data-snow></canvas>
	<div class="manta" data-manta>
		<svg viewBox="53 30 256 256">
			<defs>
				<radialGradient id="star-glow">
					<stop offset="0" stop-color="#f4f2ff" stop-opacity="0.95"></stop>
					<stop offset="0.35" stop-color="#b8acfe" stop-opacity="0.45"></stop>
					<stop offset="1" stop-color="#6dc5f1" stop-opacity="0"></stop>
				</radialGradient>
			</defs>
			<circle class="halo" cx="181" cy="86" r="70" fill="url(#star-glow)"></circle>
			<path class="body" d={MANTA_BODY}></path>
			<path class="star" d={STAR}></path>
		</svg>
	</div>
</div>

<script>
	// One loop drives everything. Layout is measured on resize, never per frame, and the loop only
	// writes transforms, opacity and values that changed, so scrolling stays on the compositor.
	const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
	const ocean = document.querySelector<HTMLElement>("[data-ocean]")!;
	const intro = ocean.hasAttribute("data-intro");
	document.body.classList.add("has-ocean");
	const manta = document.querySelector<HTMLElement>("[data-manta]")!;
	const header = document.querySelector<HTMLElement>("[data-header]");
	/** The manta is drawn at this size and only ever scaled down, so it stays sharp. */
	const MANTA = 560;

	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const clamp = (x: number, lo = 0, hi = 1) => Math.min(hi, Math.max(lo, x));
	const mix = (a: number[], b: number[], t: number) => `rgb(${a.map((x, i) => Math.round(lerp(x, b[i]!, t))).join(" ")})`;
	/** Frame-rate independent easing: the share of the gap to close after `dt` ms. */
	const follow = (dt: number, tau: number) => 1 - Math.exp(-dt / tau);

	// Writes that only happen when the value changes.
	const last = new Map<string, string>();
	function write(key: string, value: string, apply: (v: string) => void) {
		if (last.get(key) === value) return;
		last.set(key, value);
		apply(value);
	}

	// Layout, in document coordinates, measured when the page changes size.
	type Zone = { el: HTMLElement; top: number; theme: string };
	let zones: Zone[] = [];
	let maxScroll = 1;
	/** Where the first dark section starts, in document coordinates. */
	let firstDark = Infinity;
	let vw = innerWidth;
	let vh = innerHeight;

	type Floater = { el: HTMLElement; mass: number; left: number; top: number; right: number; bottom: number; x: number; y: number; seen: boolean; moving: boolean };
	const floaters: Floater[] = [...document.querySelectorAll<HTMLElement>("[data-float]")].map((el, i) => {
		const kind = el.dataset.float;
		// Each block bobs on its own clock; the bob itself is a CSS animation, off the main thread.
		el.style.setProperty("--bob-period", `${(4.2 + Math.random() * 2.6).toFixed(2)}s`);
		el.style.setProperty("--bob-delay", `${(-i * 1.7 - Math.random() * 4).toFixed(2)}s`);
		return { el, mass: kind === "heavy" ? 2.2 : kind === "light" ? 0.7 : 1.2, left: 0, top: 0, right: 0, bottom: 0, x: 0, y: 0, seen: false, moving: false };
	});

	function measure() {
		vw = innerWidth;
		vh = innerHeight;
		maxScroll = Math.max(1, document.documentElement.scrollHeight - vh);
		const y = scrollY;
		zones = [...document.querySelectorAll<HTMLElement>("main section[data-theme]")].map((el) => ({
			el,
			top: el.getBoundingClientRect().top + y,
			theme: el.dataset.theme ?? "light",
		}));
		firstDark = zones.find((z) => z.theme === "dark")?.top ?? Infinity;
		for (const f of floaters) {
			const box = f.el.getBoundingClientRect();
			f.left = box.left - f.x;
			f.right = box.right - f.x;
			f.top = box.top + y - f.y;
			f.bottom = box.bottom + y - f.y;
		}
	}

	function zoneAt(y: number): Zone | undefined {
		let zone: Zone | undefined;
		for (const z of zones) if (z.top <= y) zone = z;
		return zone ?? zones[0];
	}


	const pointer = { x: 0, y: 0, at: -1e9 };
	addEventListener(
		"pointermove",
		(event) => {
			if (event.pointerType !== "mouse") return;
			pointer.x = event.clientX;
			pointer.y = event.clientY;
			pointer.at = performance.now();
		},
		{ passive: true },
	);

	// The manta follows a target that the scroll moves; it eases toward it.
	const pos = { x: 0, y: 0, s: 1, r: 0 };
	let first = true;

	function target(now: number, sy: number, progress: number) {
		const wide = vw >= 900;
		// At the top: big, beside the headline. Then it shrinks and wanders.
		const hero = intro ? clamp(sy / (vh * 0.85)) : 1;
		const heroX = wide ? vw * 0.77 : vw * 0.6;
		const heroY = wide ? vh * 0.4 : vh * 0.2;
		const heroS = wide ? Math.min(vw * 0.34, vh * 0.62, MANTA) : Math.min(vw * 0.66, vh * 0.3);
		const swimS = wide ? 150 : 96;
		// It roams the whole window, on a slow figure of eight that the scroll and the clock both push.
		const wander = progress * Math.PI * 5.2 + (reduced ? 0 : now / 9000);
		let swimX = vw * (0.5 + (wide ? 0.38 : 0.32) * Math.sin(wander + 1.2));
		let swimY = vh * (0.45 + 0.26 * Math.sin(wander * 1.4));
		// Like a koi: when the reader moves the pointer, it drifts toward it.
		const curious = clamp(1 - (now - pointer.at) / 2500) * 0.45;
		swimX = lerp(swimX, pointer.x, curious);
		swimY = lerp(swimY, pointer.y, curious);
		return {
			x: lerp(heroX, swimX, hero),
			y: lerp(heroY, swimY, hero),
			s: lerp(heroS, swimS, hero),
			r: lerp(-6, 0, hero),
		};
	}

	/** 0 in the light, 1 in the deep; shared with the snow. */
	let dark = 0;

	function scene(now: number, dt: number, sy: number) {
		const progress = clamp(sy / maxScroll);

		// Darkness rises as the first dark section comes up the screen, and drives the manta's colours.
		// Stepped, so the SVG repaints a hundred times over the page, not every frame.
		dark = clamp((sy + vh - firstDark) / (vh * 0.6));
		const step = Math.round(dark * 100) / 100;
		write("dark", step.toFixed(2), (v) => {
			ocean.style.setProperty("--dark", v);
			manta.style.setProperty("--body", mix([20, 23, 43], [44, 49, 92], step));
			manta.style.setProperty("--star", mix([20, 23, 43], [240, 238, 255], clamp(step * 1.4)));
		});

		// The header takes the theme of the section behind it.
		if (intro && header) write("header", zoneAt(sy + 34)?.theme ?? "light", (v) => (header.dataset.theme = v));
		if (header) write("scrolled", String(sy > 8), (v) => header.classList.toggle("is-scrolled", v === "true"));

		const t = target(now, sy, progress);
		const ease = first || reduced ? 1 : follow(dt, 200);
		first = false;
		pos.x = lerp(pos.x, t.x, ease);
		pos.y = lerp(pos.y, t.y, ease);
		pos.s = lerp(pos.s, t.s, ease);
		// Bank into the turn: tilt with the sideways speed.
		pos.r = lerp(pos.r, t.r + clamp((t.x - pos.x) / 18, -22, 22), ease);
		const bob = reduced ? 0 : Math.sin(now / 1400) * 6;
		manta.style.transform = `translate3d(${(pos.x - MANTA / 2).toFixed(2)}px, ${(pos.y - MANTA / 2 + bob).toFixed(2)}px, 0) scale(${(pos.s / MANTA).toFixed(4)}) rotate(${pos.r.toFixed(2)}deg)`;
		// On light ground it swims as a faint shadow behind the words; on dark ground, solid, lit by its star.
		const swimming = intro ? clamp(sy / (vh * 0.85)) : 1;
		write("opacity", Math.max(lerp(1, 0.16, swimming), clamp((dark - 0.2) / 0.5)).toFixed(3), (v) => (manta.style.opacity = v));
	}

	// The manta's wake pushes the blocks it swims past; they ease back when it's gone.
	const watcher = new IntersectionObserver((entries) => {
		for (const entry of entries) {
			const f = floaters.find((x) => x.el === entry.target);
			if (f) f.seen = entry.isIntersecting;
		}
	});
	for (const f of floaters) watcher.observe(f.el);

	function wake(dt: number, sy: number) {
		const reach = Math.min(260, Math.max(140, pos.s * 0.75));
		const mx = pos.x;
		const my = pos.y + sy;
		for (const f of floaters) {
			if (!f.seen && !f.moving) continue;
			let tx = 0;
			let ty = 0;
			// Someone is typing in it: hold still.
			if (f.seen && !f.el.matches(":focus-within")) {
				const dx = clamp(mx, f.left, f.right) - mx;
				const dy = clamp(my, f.top, f.bottom) - my;
				const d = Math.hypot(dx, dy);
				if (d < reach) {
					const push = (1 - d / reach) ** 2 * 18;
					const len = d || 1;
					tx = d === 0 ? 0 : (dx / len) * push;
					ty = d === 0 ? -push : (dy / len) * push;
				}
			}
			const ease = follow(dt, 320 * f.mass);
			f.x = lerp(f.x, tx, ease);
			f.y = lerp(f.y, ty, ease);
			f.moving = Math.abs(f.x) > 0.05 || Math.abs(f.y) > 0.05 || tx !== 0 || ty !== 0;
			if (!f.moving) {
				f.x = 0;
				f.y = 0;
			}
			f.el.style.transform = f.moving ? `translate3d(${f.x.toFixed(2)}px, ${f.y.toFixed(2)}px, 0)` : "";
		}
	}

	// Specks: pale on light ground, glowing on dark.
	// Each speck is a pre-drawn sprite; blurring shadows per speck every frame is what made it heavy.
	const canvas = document.querySelector<HTMLCanvasElement>("[data-snow]")!;
	const ctx = canvas.getContext("2d")!;
	const colours = ["#cde8f7", "#d9d0ff", "#d3f3e6", "#ffffff"];
	const SPRITE = 32;
	function sprite(colour: string, glow: boolean) {
		const c = document.createElement("canvas");
		c.width = c.height = SPRITE;
		const g = c.getContext("2d")!;
		const gradient = g.createRadialGradient(SPRITE / 2, SPRITE / 2, 0, SPRITE / 2, SPRITE / 2, SPRITE / 2);
		gradient.addColorStop(0, colour);
		gradient.addColorStop(glow ? 0.18 : 0.22, colour);
		gradient.addColorStop(glow ? 0.3 : 0.28, glow ? `${colour}88` : `${colour}00`);
		gradient.addColorStop(1, `${colour}00`);
		g.fillStyle = gradient;
		g.fillRect(0, 0, SPRITE, SPRITE);
		return c;
	}
	const plain = sprite("#ffffff", false);
	const glows = colours.map((c) => sprite(c, true));
	type Flake = { x: number; y: number; r: number; v: number; drift: number; glow: HTMLCanvasElement; tw: number };
	let flakes: Flake[] = [];

	function resizeSnow() {
		const dpr = Math.min(devicePixelRatio, 2);
		canvas.width = vw * dpr;
		canvas.height = vh * dpr;
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		const count = Math.round(Math.min(140, (vw * vh) / 10000));
		// A phone's toolbar sliding away changes the height only: keep the snow where it is.
		if (flakes.length && Math.abs(flakes.length - count) < 20) return;
		flakes = Array.from({ length: count }, () => ({
			x: Math.random() * vw,
			y: Math.random() * vh,
			r: 0.6 + Math.random() * 1.8,
			v: 0.08 + Math.random() * 0.25,
			drift: Math.random() * Math.PI * 2,
			glow: glows[Math.floor(Math.random() * glows.length)]!,
			tw: Math.random() * Math.PI * 2,
		}));
	}

	function snow(now: number, dt: number, scrolled: number) {
		ctx.clearRect(0, 0, vw, vh);
		const steps = dt / 16.67;
		const lit = dark > 0.4;
		for (const f of flakes) {
			if (!reduced) {
				// Parallax: the snow moves a little against the scroll, and sinks slowly.
				f.y += f.v * steps - scrolled * 0.14 * f.r;
				f.x += Math.sin(now / 3000 + f.drift) * 0.15 * steps;
			}
			if (f.y > vh + 8) f.y -= vh + 16;
			if (f.y < -8) f.y += vh + 16;
			const glow = dark * (0.55 + 0.45 * Math.sin(now / 900 + f.tw));
			ctx.globalAlpha = lerp(0.35, 0.25 + glow * 0.75, dark);
			// The sprite's core fills a quarter of it; a lit speck carries its halo around it.
			const size = f.r * (lit ? 4 + 4 * dark : 4.4);
			ctx.drawImage(lit ? f.glow : plain, f.x - size / 2, f.y - size / 2, size, size);
		}
		ctx.globalAlpha = 1;
	}

	let lastTime = performance.now();
	let lastScroll = scrollY;
	function frame(now: number) {
		const dt = Math.min(64, now - lastTime);
		lastTime = now;
		const sy = scrollY;
		const scrolled = sy - lastScroll;
		lastScroll = sy;
		scene(now, dt, sy);
		if (!reduced) wake(dt, sy);
		snow(now, dt, scrolled);
		requestAnimationFrame(frame);
	}

	function relayout() {
		measure();
		resizeSnow();
	}
	measure();
	resizeSnow();
	// Sizes settle after fonts and late content; re-measure then, and whenever the page resizes.
	let pending = 0;
	new ResizeObserver(() => {
		cancelAnimationFrame(pending);
		pending = requestAnimationFrame(() => (vw !== innerWidth || vh !== innerHeight ? relayout() : measure()));
	}).observe(document.body);
	addEventListener("resize", () => {
		cancelAnimationFrame(pending);
		pending = requestAnimationFrame(relayout);
	});
	document.fonts?.ready.then(measure);
	requestAnimationFrame(frame);
</script>

<style>
	.ocean {
		position: fixed;
		inset: 0;
		z-index: 1;
		pointer-events: none;
	}
	.snow {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.manta {
		position: absolute;
		top: 0;
		left: 0;
		width: 560px;
		aspect-ratio: 1;
		will-change: transform, opacity;
		filter: drop-shadow(0 30px 40px rgb(20 23 43 / calc(0.22 - var(--dark, 0) * 0.2)));
	}
	.manta svg {
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.body {
		fill: var(--body, #14172b);
		stroke: rgb(184 172 254 / calc(var(--dark, 0) * 0.55));
		stroke-width: 1.2;
	}
	.star {
		fill: var(--star, #14172b);
	}
	.halo {
		opacity: calc(var(--dark, 0) * 1);
		transform-origin: 181px 86px;
		animation: pulse 3.2s ease-in-out infinite;
	}
	@keyframes pulse {
		50% {
			transform: scale(1.18);
			opacity: calc(var(--dark, 0) * 0.7);
		}
	}
</style>
