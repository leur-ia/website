---
/** A plain reading page: the privacy policy, the code signing policy. */
import Base from "./Base.astro";

interface Props {
	title: string;
	description: string;
	/** When the text last changed, as shown on the page ("30 September 2026"). */
	updated: string;
}

const { title, description, updated } = Astro.props;
---

<Base title={`${title} · Leuria`} description={description}>
	<article class="legal container">
		<header>
			<h1 class="heading-1">{title}</h1>
			<p class="muted">Last updated {updated}</p>
		</header>
		<slot />
	</article>
</Base>

<style>
	.legal {
		display: grid;
		gap: var(--space-4);
		max-width: calc(720px + var(--gutter) * 2);
		padding-top: clamp(48px, 8vw, 96px);
		padding-bottom: clamp(64px, 10vw, 120px);
	}
	header {
		display: grid;
		gap: var(--space-2);
		margin-bottom: var(--space-4);
	}
	.legal :global(h2) {
		margin-top: var(--space-6);
		font-size: 20px;
		line-height: 28px;
		font-weight: 700;
		letter-spacing: -0.015em;
	}
	.legal :global(p),
	.legal :global(li) {
		text-wrap: pretty;
	}
	.legal :global(ul) {
		display: grid;
		gap: var(--space-2);
		margin: 0;
		padding-left: 1.25em;
	}
	.legal :global(a) {
		color: var(--accent-text);
	}
	.legal :global(strong) {
		font-weight: 700;
	}
</style>
