---
import { Font } from "astro:assets";

import Consent from "../components/Consent.astro";
import DownloadButton from "../components/DownloadButton.astro";
import Logo from "../components/Logo.astro";
import { DEVELOPERS_URL } from "../data/site";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	/** Hide the header's download action on pages whose own main action is the download. */
	headerDownload?: boolean;
	/** The header floats over the page and takes the theme of the section under it. */
	immersive?: boolean;
	/** The picture shown when the page is shared (1200×630), from public/. */
	image?: string;
	/** Structured data for search engines (schema.org), one object or several. */
	jsonLd?: object | object[];
	/** Keep the page out of search results (the 404 page). */
	noindex?: boolean;
}

const { title, description, headerDownload = true, immersive = false, image = "/og.jpg", jsonLd, noindex = false } = Astro.props;
const imageUrl = new URL(image, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
	// A page without the header's download button gets a Download link instead.
	...(headerDownload ? [] : [{ href: "/download", label: "Download" }]),
	{ href: "/#how", label: "How it works" },
	{ href: "/#privacy", label: "Privacy" },
	{ href: "/websites", label: "For websites" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		{noindex && <meta name="robots" content="noindex" />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Leuria" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Leuria: use the AI you already have, on the websites you choose" />
		<meta name="twitter:card" content="summary_large_image" />
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
		<meta name="theme-color" content="#eef0f7" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0f1120" media="(prefers-color-scheme: dark)" />
		<Font cssVariable="--font-jakarta" preload />
		<Font cssVariable="--font-geist-mono" />
	</head>
	<body class:list={{ immersive }}>
		<a class="skip" href="#main">Skip to content</a>
		<header class="site-header" data-header>
			<div class="container bar">
				<a href="/" class="home" aria-label="Leuria, home"><Logo size={26} /></a>
				<nav aria-label="Main">
					<ul>
						{
							nav.map((item) => (
								<li class:list={{ keep: item.href === "/download" }}>
									<a href={item.href} aria-current={item.href === path ? "page" : undefined}>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
				{headerDownload && <div class="header-action"><DownloadButton variant="quiet" size="md" /></div>}
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<p class="footer-what muted">Your own AI, on the web</p>
			<nav class="footer-links" aria-label="Footer">
				<a href="/download">Download</a>
				<a href="/websites">For websites</a>
				<a href={DEVELOPERS_URL}>Developer docs</a>
				<a class="gh-link" href="https://github.com/leur-ia/leuria"><svg class="gh" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg> GitHub</a>
				<a href="/code-signing">Code signing</a>
			</nav>
			<p class="footer-meta muted">
				2026 · <a href="/privacy-policy">Privacy policy</a> · <button type="button" class="footer-link" data-consent-open>Visit counting</button>
			</p>
		</footer>
		<Consent />
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: var(--space-4);
		top: -100px;
		z-index: 100;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-full);
		background: var(--ink);
		color: var(--on-ink);
	}
	.skip:focus {
		top: var(--space-3);
	}

	/* A plain bar: the wordmark, a few links, one action. */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--bg);
	}
	.bar {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		min-height: 68px;
	}
	.home {
		display: inline-flex;
		align-items: center;
		min-height: var(--target-min);
		text-decoration: none;
	}
	nav ul {
		display: flex;
		gap: var(--space-1);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.bar nav {
		margin-left: auto;
	}
	.bar nav a {
		display: inline-flex;
		align-items: center;
		min-height: var(--target-min);
		padding: 0 var(--space-3);
		border-radius: var(--radius-full);
		color: var(--text-muted);
		font-size: 15px;
		font-weight: 500;
		text-decoration: none;
		transition: color var(--timing-fast) var(--easing-standard);
	}
	.bar nav a:hover,
	.bar nav a[aria-current="page"] {
		color: var(--text);
	}
	/* Phones and tablets: the bar scrolls away with the page, and keeps the logo and the download. */
	@media (max-width: 860px) {
		.site-header {
			position: static;
		}
	}
	@media (max-width: 719px) {
		.bar nav li:not(.keep) {
			display: none;
		}
		.header-action {
			margin-left: auto;
		}
	}

	/* A single quiet line, after the page has made its invitation. */
	.site-footer {
		display: grid;
		grid-template-columns: 1fr max-content 1fr;
		align-items: baseline;
		gap: var(--space-5);
		margin-top: 30svh;
		padding: 0 var(--gutter) 30px;
		font-size: 15px;
		line-height: 24px;
	}
	.footer-links {
		display: flex;
		gap: var(--space-5);
		justify-content: center;
	}
	.footer-links a {
		display: inline-flex;
		align-items: center;
		flex: 0 0 auto;
		gap: 6px;
		color: var(--text);
		text-decoration: none;
		white-space: nowrap;
	}
	.footer-links .gh {
		flex: 0 0 auto;
	}
	.footer-links a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.footer-meta {
		text-align: right;
	}
	.footer-meta a {
		color: var(--text);
	}
	.footer-link {
		padding: 0;
		border: 0;
		background: none;
		color: var(--text);
		font: inherit;
		text-decoration: underline;
		cursor: pointer;
	}
	@media (max-width: 719px) {
		.site-footer {
			grid-template-columns: 1fr;
			gap: var(--space-2);
			margin-top: 20svh;
			padding-bottom: 24px;
			font-size: 14px;
		}
		.footer-links {
			justify-content: flex-start;
			flex-wrap: wrap;
			gap: var(--space-3) var(--space-4);
		}
		.footer-meta {
			text-align: left;
		}
	}
</style>
